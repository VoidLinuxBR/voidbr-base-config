pkgname=voidbr-base-config
pkgdesc="Skel config for VoidBR BASE/SERVER"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-xbps
	voidbr-nano-config
	voidbr-vinstall
	# voidbr-grub-theme
	bash-completion
	fzf
	tree
	duf
	parted
	rsync
	nvme-cli
	curl
	wget
	nano
	plymouth
)
backup=(/etc/ssh/sshd_config.d/10-custom.conf)

package() {
  # Verify default folder
  if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
    InternalDir="${srcdir}/${pkgname}/${pkgname}"
  elif [ -d "${srcdir}/${pkgname}" ]; then
    InternalDir="${srcdir}/${pkgname}"
  else
    #local
    InternalDir="${WORKDIR}"
  fi

  cd "${InternalDir}"
  # Copiar a estrutura de /etc, /usr e /opt para /
  local dirs=("boot" "etc" "opt" "usr" "var")
  for dir in "${dirs[@]}"; do
    if [ -d "${InternalDir}/${dir}" ]; then
      cp -a "${InternalDir}/${dir}" "${pkgdir}/"
    fi
  done

  # Install license file if present
  [ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # Install documentation if present
  [ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
  if [ "${update:-}" = "yes" ]; then
    log "Finalizando upgrade"
  else
    log "Finalizando instalação"
  fi
	rm -f /etc/grub.d/*new*
	# ed -> nano, só se ainda não existir nenhum ed (link ou arquivo): o
	# voidbr-goedit traz o seu próprio /usr/local/bin/ed -> goedit e não pode
	# ser sobrescrito. Antes isso era feito via sudo num script do
	# /etc/profile.d, a cada login, e travava pedindo senha pra usuários sem
	# NOPASSWD (ex: o _greeter do greetd).
	if [ ! -e /usr/local/bin/ed ] && [ ! -L /usr/local/bin/ed ]; then
		install -d /usr/local/bin
		ln -s /usr/bin/nano /usr/local/bin/ed
	fi

}

pre_upgrade() {
  post_install
}

post_upgrade() {
	log "Finalizando upgrade"
}
