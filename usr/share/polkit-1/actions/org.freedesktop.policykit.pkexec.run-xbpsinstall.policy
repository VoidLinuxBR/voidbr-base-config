<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>VoidBR Linux</vendor>
  <vendor_url>https://voidbr.org</vendor_url>
  <icon_name>octopi</icon_name>

  <action id="org.freedesktop.policykit.pkexec.run-xbpsinstall">
    <description>Check for package updates (OctoXBPS Notifier)</description>
    <description xml:lang="pt_BR">Verificar atualizações de pacotes (OctoXBPS Notifier)</description>

    <message>OctoXBPS Notifier (the update icon in the system tray) needs to download the package list to check for updates. Nothing will be installed, removed or changed.</message>
    <message xml:lang="pt_BR">O OctoXBPS Notifier (ícone de atualizações na bandeja do sistema) precisa baixar a lista de pacotes para verificar se há atualizações. Nenhum pacote será instalado, removido ou alterado.</message>

    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/xbps-install</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-Sy</annotate>
  </action>
</policyconfig>
